# PocketBase server URL (required for production builds)
# If not set, defaults to window.location.origin (works when served from PocketBase)
VITE_POCKETBASE_URL=https://your-pocketbase-instance.example.com

# Dados de demonstração: true = painel roda sem servidor, com hashes e cadeia
# calculados de verdade (mesmo código do app). Toda tela mostra o selo
# "DADOS DE DEMONSTRAÇÃO". NUNCA usar true em produção.
VITE_USE_MOCK=true
